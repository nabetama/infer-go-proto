// *Slice のフィールドに入力元でない値を書き、fmt_sprintf の戻り値を危険な関数に渡す（報告されない）。

type S = {}
type Slice = { elem: *S }

declare source() : *S
declare sink(*S) : void
declare fmt_sprintf(*S, *Slice) : *S

define f(format: *S) : void {
  #b0:
    n0 = source()
    n1 = __sil_allocate(<Slice>)
    n2: *S = load &format
    store n1.Slice.elem <- n2 : *S
    n3 = fmt_sprintf(n2, n1)
    n4 = sink(n3)
    ret null
}
